# Copy to .env and fill in. Keys are needed only to re-run inference;
# the notebooks that regenerate all tables and figures from results/
# need no keys and no .env.
#
# Load with:  set -a; source .env; set +a

# HuggingFace Inference router: the four Qwen models
HUGGINGFACE_API_KEY=hf_...

# Anthropic API: Claude Opus 4.7
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API (google-genai SDK): Gemma-4. GEMINI_API_KEY also works.
GOOGLE_API_KEY=...

# SQLAlchemy URL of the local bird_minidev PostgreSQL. The runner uses it to
# execute the generated SQL (ER) and score against gold results (BEX).
GYZASQL_BIRD_DATABASE_URL=postgresql+psycopg://localhost/bird_minidev
